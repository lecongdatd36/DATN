msgid "Đặt trước cho bữa hẹn"
msgstr "Preorder for your visit"

msgid "Đến mới chế biến"
msgstr "Prepare on arrival"

msgid "Đến mới chế biến: nhà hàng gửi bếp khi bạn đến. Chuẩn bị theo giờ: nhà hàng sẽ chốt món và giờ phục vụ với bạn trước khi nhận cọc."
msgstr "Prepare on arrival: your dishes are sent to the kitchen when you arrive. Advance preparation: the restaurant agrees on the menu and serving time before requesting a deposit."

msgid "ĐỂ DÀNH MỘT CHỖ NGỒI"
msgstr "SAVE A SEAT AT THE TABLE"

msgid "ĐỂ DÀNH THỜI GIAN CHO NHAU"
msgstr "MAKE A LITTLE TIME TOGETHER"

msgid "Để dành một chỗ ngồi cho người thương."
msgstr "Save a seat for someone special."

msgid "Để xem món, giờ hẹn và tiền cọc, hãy tra cứu trên trình duyệt đã dùng đặt bàn hoặc mở liên kết riêng đã nhận sau khi đặt. Mã và số điện thoại chỉ dùng kiểm tra trạng thái."
msgstr "To see dishes, arrival time and deposits, use the browser that made the booking or open your private link. A booking code and phone number alone reveal only the general status."

msgid "Đồ uống"
msgstr "Drinks"

msgid "Đồng ý bản chốt & giữ chỗ"
msgstr "Accept the offer & hold the table"

msgid "đ"
msgstr "₫"

msgid "đ /"
msgstr "₫ /"

msgid "đ / combo"
msgstr "₫ / combo"

msgid "đ ·"
msgstr "₫ ·"

msgid "đang chờ xác nhận. Trang sẽ tự mở gọi món sau khi nhân viên nhận bàn."
msgstr "is awaiting confirmation. Ordering will open automatically after staff check you in."

msgid "đang phục vụ."
msgstr "in service."

msgid "đã chốt"
msgstr "agreed"

msgid "để Cơm Quê đón bạn chu đáo."
msgstr "and let Cơm Quê welcome you."

msgid "để xử lý. Không nhập thông tin nhạy cảm."
msgstr "for processing. Do not enter sensitive information."

msgid "Ảnh món đang được cập nhật"
msgstr "Dish photo coming soon"

msgid "Ẩm thực Việt, kể bằng sự tử tế."
msgstr "Vietnamese food, made with care."

msgid "← Quay lại thực đơn"
msgstr "← Back to the menu"

msgid "← Sửa thông tin đặt bàn"
msgstr "← Edit booking details"

msgid "← Trở về hóa đơn"
msgstr "← Back to the bill"

msgid "← Trở về lịch đặt bàn"
msgstr "← Back to your reservation"

msgid "← Về trang chủ"
msgstr "← Back to home"

msgid "← Đổi lựa chọn đặt món trước"
msgstr "← Change preorder preference"

msgid "＋ Thêm món"
msgstr "＋ Add dish"

msgid "%(dish)s: tổng số phần trong món lẻ và combo không được vượt 100."
msgstr "%(dish)s: the combined quantity across dishes and combos cannot exceed 100."

msgid "Chưa gửi Bếp"
msgstr "Not sent to kitchen"

msgid "Đang làm"
msgstr "Preparing"

msgid "Đã xong"
msgstr "Ready"

msgid "Đã phục vụ"
msgstr "Served"

msgid "Chờ nhân viên xác nhận"
msgstr "Awaiting staff confirmation"

msgid "Đã từ chối"
msgstr "Declined"

msgid "Đã nhận bàn"
msgstr "Checked in"

msgid "Đã hết hạn"
msgstr "Expired"

msgid "Đang chờ nhân viên"
msgstr "Waiting for staff"

msgid "Trợ lý đang chờ cấu hình API. Bạn vẫn có thể xem thực đơn hoặc đặt bàn."
msgstr "The assistant is not configured yet. You can still browse the menu or book a table."

msgid "Trợ lý đang chờ cấu hình Groq API. Bạn vẫn có thể xem thực đơn hoặc đặt bàn."
msgstr "The assistant is not configured yet. You can still browse the menu or book a table."

msgid "Trợ lý đang chờ cấu hình Gemini API. Bạn vẫn có thể xem thực đơn hoặc đặt bàn."
msgstr "The assistant is not configured yet. You can still browse the menu or book a table."

msgid "Cuộc trò chuyện đã đạt giới hạn. Hãy bấm Trò chuyện mới để tiếp tục."
msgstr "The conversation limit has been reached. Start a new conversation to continue."

msgid "Nội dung trao đổi đã dài. Vui lòng bắt đầu cuộc trò chuyện mới."
msgstr "This conversation is getting long. Please start a new one."

msgid "Trợ lý tạm chưa sẵn sàng. Vui lòng xem thực đơn hoặc mở form đặt bàn."
msgstr "The assistant is temporarily unavailable. Please browse the menu or open the booking form."

msgid "Kết quả thanh toán"
msgstr "Payment result"

msgid "ĐẶT CỌC BÀN · ZALOPAY"
msgstr "TABLE DEPOSIT · ZALOPAY"

msgid "THANH TOÁN HÓA ĐƠN · ZALOPAY"
msgstr "BILL PAYMENT · ZALOPAY"

msgid "Theo dõi thanh toán cọc cho lịch hẹn của bạn."
msgstr "Track the deposit payment for your reservation."

msgid "Hoàn tất thanh toán và tiếp tục quản lý bàn, hóa đơn."
msgstr "Complete the payment and return to your tables and bills."

msgid "Số tiền thanh toán"
msgstr "Payment amount"

msgid "Mã giao dịch"
msgstr "Transaction reference"

msgid "Giao dịch đang được nhà hàng đối soát. Vui lòng giữ mã giao dịch để kiểm tra."
msgstr "The restaurant is reconciling this payment. Keep your reference for follow-up."

msgid "Đang cập nhật kết quả thanh toán. Vui lòng chờ xác nhận từ hệ thống."
msgstr "Updating the payment result. Please wait for confirmation."

msgid "Trở về lịch đặt bàn"
msgstr "Return to reservation"

msgid "Trở về bàn / hóa đơn"
msgstr "Return to tables / bill"

msgid "Mở trang thanh toán"
msgstr "Open payment page"

msgid "Giữ mã giao dịch để tra cứu. Hệ thống tự cập nhật kết quả; chỉ thanh toán một lần cho mỗi giao dịch."
msgstr "Keep your payment reference. The result updates automatically; pay only once per transaction."

msgid "ZaloPay (chưa cấu hình)"
msgstr "ZaloPay (not configured)"
