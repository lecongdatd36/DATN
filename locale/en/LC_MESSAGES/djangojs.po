# English customer-facing translations for Com Que.
msgid ""
msgstr "Project-Id-Version: Com Que\nLanguage: en\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid " món"
msgstr " items"

msgid "<p class=\"customer-qr-cart-empty\">Chưa có món trong giỏ.</p>"
msgstr "<p class=\"customer-qr-cart-empty\">Your basket is empty.</p>"

msgid "Bạn"
msgstr "You"

msgid "COMBO TRỌN BỮA"
msgstr "MEAL COMBO"

msgid "Chưa có gợi ý phù hợp với các món đã chọn."
msgstr "No matching suggestions for the selected dishes yet."

msgid "Chưa cập nhật được giỏ món."
msgstr "Your basket could not be updated."

msgid "Chưa kết nối được máy chủ. Giữ mã giao dịch để kiểm tra lại."
msgstr "Unable to reach the server. Keep your transaction reference and check again."

msgid "Chưa kết nối được trợ lý. Vui lòng thử lại sau."
msgstr "Unable to reach the assistant. Please try again later."

msgid "Chưa lấy được kết quả."
msgstr "Unable to retrieve the result."

msgid "Chưa tải được gợi ý. Bạn vẫn có thể chọn món bình thường."
msgstr "Suggestions could not be loaded. You can still choose dishes normally."

msgid "Chưa xác minh được thanh toán. Giữ mã giao dịch và tiếp tục chờ hoặc truy vấn lại."
msgstr "Payment has not been verified yet. Keep your reference and wait or check again."

msgid "Chọn món để xem gợi ý ăn kèm."
msgstr "Choose dishes to see suggestions for your meal."

msgid "Câu hỏi tối đa 1.000 ký tự."
msgstr "Questions must be 1,000 characters or fewer."

msgid "Ghi chú món"
msgstr "Dish notes"

msgid "Giao dịch chưa thành công. Quay lại đơn để tạo yêu cầu mới."
msgstr "The transaction was unsuccessful. Return to the order to start a new payment."

msgid "Giảm"
msgstr "Decrease"

msgid "Gợi ý gọi thêm từ Apriori"
msgstr "Apriori suggestions"

msgid "Gợi ý ăn kèm: "
msgstr "Suggested additions: "

msgid "Gửi yêu cầu gọi món"
msgstr "Submit food order"

msgid "Không kết nối được giỏ món. Vui lòng tải lại trang."
msgstr "Unable to connect to your basket. Please reload the page."

msgid "Không thể gửi yêu cầu nhận bàn."
msgstr "Unable to submit the check-in request."

msgid "Không thể gửi yêu cầu phục vụ."
msgstr "Unable to submit the service request."

msgid "Không thể gửi yêu cầu. Vui lòng thử lại."
msgstr "Unable to submit the request. Please try again."

msgid "Kiểm tra / gửi lại yêu cầu"
msgstr "Check / resubmit request"

msgid "Kết nối đang chậm. Vui lòng chờ rồi thử lại."
msgstr "The connection is slow. Please wait and try again."

msgid "Kết nối đang chậm. Vui lòng thử lại sau."
msgstr "The connection is slow. Please try again later."

msgid "MÓN LẺ"
msgstr "INDIVIDUAL DISH"

msgid "Máy chủ đã xác minh thanh toán thành công."
msgstr "The server has verified your successful payment."

msgid "Món ngon cho bữa cơm nhà"
msgstr "Good food for a lovely meal"

msgid "Mở menu"
msgstr "Open navigation"

msgid "Nhân viên đã nhận bàn. Đang mở chức năng gọi món..."
msgstr "You are checked in. Opening the ordering menu..."

msgid "Phiên bảo mật đã đổi. Vui lòng tải lại trang."
msgstr "Your security session has changed. Please reload the page."

msgid "Phiên gọi món đã hết hạn. Hãy tải lại mã QR rồi gửi lại."
msgstr "Your ordering session has expired. Scan the QR code again and resubmit."

msgid "Thêm "
msgstr "Add "

msgid "Thực đơn"
msgstr "Menu"

msgid "Trợ lý"
msgstr "Assistant"

msgid "Trợ lý đang chờ cấu hình API. Bạn vẫn có thể xem thực đơn và đặt bàn."
msgstr "The assistant is not configured yet. You can still browse the menu and book a table."

msgid "Trợ lý đang trả lời…"
msgstr "The assistant is replying…"

msgid "Tăng"
msgstr "Increase"

msgid "Vui lòng bỏ món/combo không còn phục vụ trước khi đặt bàn."
msgstr "Remove unavailable dishes or combos before booking."

msgid "Vui lòng liên hệ nhân viên."
msgstr "Please contact a member of staff."

msgid "Ví dụ: không hành"
msgstr "For example: no onions"

msgid "Yêu cầu nhận bàn"
msgstr "Request check-in"

msgid "Yêu cầu trước có thể đã tới hệ thống. Bấm “Kiểm tra / gửi lại” để xác nhận, hệ thống sẽ không tạo trùng."
msgstr "Your previous request may have reached the system. Use “Check / resubmit” to confirm it; the system will not create a duplicate."

msgid "Yêu cầu đã hết hạn. Bạn có thể gửi lại."
msgstr "Your request has expired. You can submit it again."

msgid "món"
msgstr "items"

msgid "nhà hàng"
msgstr "the restaurant"

msgid "Đang gửi yêu cầu tới nhân viên..."
msgstr "Sending your request to staff..."

msgid "Đang gửi..."
msgstr "Sending..."

msgid "Đang gửi…"
msgstr "Sending…"

msgid "Đang mở cuộc trò chuyện…"
msgstr "Opening your conversation…"

msgid "Đang tìm gợi ý phù hợp…"
msgstr "Finding suggestions for your meal…"

msgid "Đã báo"
msgstr "Notified"

msgid "Đã nhận tiền Sandbox, nhà hàng cần đối soát trước khi xác nhận đơn."
msgstr "Sandbox payment received. The restaurant must reconcile it before confirming the order."

msgid "Đã thêm vào giỏ món."
msgstr "Added to your basket."

msgid "Đã đạt giới hạn lượt. Bấm Trò chuyện mới để tiếp tục."
msgstr "The conversation limit has been reached. Start a new conversation to continue."

msgid "Đóng menu"
msgstr "Close navigation"

msgid "đ"
msgstr "₫"

msgid "＋ Thêm món"
msgstr "＋ Add dish"

msgid "Lý do:"
msgstr "Reason:"

msgid "Kết quả thanh toán"
msgstr "Payment result"

msgid "ĐẶT CỌC BÀN · ZALOPAY"
msgstr "TABLE DEPOSIT · ZALOPAY"

msgid "THANH TOÁN HÓA ĐƠN · ZALOPAY"
msgstr "BILL PAYMENT · ZALOPAY"

msgid "Theo dõi thanh toán cọc cho lịch hẹn của bạn."
msgstr "Track the deposit payment for your reservation."

msgid "Hoàn tất thanh toán và tiếp tục quản lý bàn, hóa đơn."
msgstr "Complete the payment and return to your tables and bills."

msgid "Số tiền thanh toán"
msgstr "Payment amount"

msgid "Mã giao dịch"
msgstr "Transaction reference"

msgid "Trạng thái"
msgstr "Status"

msgid "Giao dịch đang được nhà hàng đối soát. Vui lòng giữ mã giao dịch để kiểm tra."
msgstr "The restaurant is reconciling this payment. Keep your reference for follow-up."

msgid "Đang cập nhật kết quả thanh toán. Vui lòng chờ xác nhận từ hệ thống."
msgstr "Updating the payment result. Please wait for confirmation."

msgid "Trở về lịch đặt bàn"
msgstr "Return to reservation"

msgid "Trở về bàn / hóa đơn"
msgstr "Return to tables / bill"

msgid "Mở trang thanh toán"
msgstr "Open payment page"

msgid "Giữ mã giao dịch để tra cứu. Hệ thống tự cập nhật kết quả; chỉ thanh toán một lần cho mỗi giao dịch."
msgstr "Keep your payment reference. The result updates automatically; pay only once per transaction."

msgid "ZaloPay (chưa cấu hình)"
msgstr "ZaloPay (not configured)"
