# Copy to .env.sqlserver. Use QLNH.sqlserver_settings on this branch.
# Existing .env still supplies SECRET_KEY, restaurant and payment configuration.
SQLSERVER_HOST=localhost
SQLSERVER_PORT=
SQLSERVER_DB=QLNH_SQLSERVER
# Blank uses Windows Authentication. Enter both for a SQL Server login.
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Local Developer instance only; production must use a trusted certificate.
SQLSERVER_EXTRA_PARAMS=Encrypt=yes;TrustServerCertificate=yes
