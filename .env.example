# Copy to .env, generate a new SECRET_KEY, and enter your local DB password.
SECRET_KEY=
GEMINI_API_KEY=
# Blank uses gemini-3.1-flash-lite (documented Free Tier); no automatic fallback.
GEMINI_MODEL=
# Choose one server-side provider. Keep Groq account on Free Plan.
CHATBOT_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Public facts: leave unknown values empty, never copy placeholder contact details.
RESTAURANT_ADDRESS=
RESTAURANT_OPENING_HOURS=
RESTAURANT_PHONE=
RESTAURANT_EMAIL=
RESTAURANT_PUBLIC_POLICY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Offline daily forecast publication. Keep application data separate from demo.
ORDER_FORECAST_SOURCE=mo_phong
# Optional absolute shared/persistent path; default: artifacts/ai/forecast
# ORDER_FORECAST_ROOT=D:/DOANTOTNGHIEP/artifacts/ai/forecast
# Offline daily forecast publication. Keep application data separate from demo.
ORDER_FORECAST_SOURCE=mo_phong
# Optional absolute shared/persistent path; default: artifacts/ai/forecast
# ORDER_FORECAST_ROOT=D:/DOANTOTNGHIEP/artifacts/ai/forecast
# URL công khai để in QR; trên Render tự lấy RENDER_EXTERNAL_URL nếu bỏ trống.
PUBLIC_BASE_URL=
# Danh sách origin HTTPS công khai, phân cách bằng dấu phẩy (ví dụ https://qlnh.example.com).
CSRF_TRUSTED_ORIGINS=

DB_NAME=QLNH_DB
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# VNPAY sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg/
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Bắt buộc là URL HTTPS công khai khi chạy IPN thật, ví dụ https://example.com/sales/payment/vnpay/return/
VNPAY_RETURN_URL=
